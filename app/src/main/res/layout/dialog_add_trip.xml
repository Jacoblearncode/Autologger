<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trip Purpose / Destination"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etTripPurpose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edit_text_background"
        android:hint="e.g. Work commute, Family trip"
        android:inputType="textCapSentences"
        android:padding="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etTripDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edit_text_background"
        android:clickable="true"
        android:focusable="false"
        android:hint="Select date"
        android:inputType="none"
        android:padding="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Odometer (km)"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etStartOdometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edit_text_background"
        android:hint="km at start"
        android:inputType="numberDecimal"
        android:padding="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="End Odometer (km)"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etEndOdometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edit_text_background"
        android:hint="km at end"
        android:inputType="numberDecimal"
        android:padding="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notes (optional)"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etTripNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/edit_text_background"
        android:hint="Passengers, fuel stop, etc."
        android:inputType="textMultiLine"
        android:minLines="2"
        android:padding="10dp" />

</LinearLayout>
