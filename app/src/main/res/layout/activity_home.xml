<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

  <!-- Header: App name + greeting + menu -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/bg_surface"
      android:paddingStart="20dp"
      android:paddingEnd="12dp"
      android:paddingTop="16dp"
      android:paddingBottom="16dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:elevation="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

      <TextView
          android:id="@+id/tvAppName"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="AutoCare"
          android:textColor="@color/accent_lime"
          android:textSize="22sp"
          android:textStyle="bold"
          android:letterSpacing="0.02" />

      <TextView
          android:id="@+id/tvGreeting"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Hello, User"
          android:textSize="13sp"
          android:textColor="@color/text_secondary"
          android:layout_marginTop="2dp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/ivMenu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/baseline_menu_24"
        android:tint="@color/text_secondary"
        android:contentDescription="Menu"
        android:padding="8dp" />

  </LinearLayout>

  <!-- Offline banner — visible only when no internet -->
  <TextView
      android:id="@+id/tvOfflineBanner"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/red"
      android:gravity="center"
      android:padding="8dp"
      android:text="No internet connection"
      android:textColor="@color/white"
      android:textSize="12sp"
      android:visibility="gone" />

  <!-- Search bar -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:layout_marginTop="16dp"
      android:background="@drawable/search_bar_background"
      android:orientation="horizontal"
      android:padding="4dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_search"
        android:tint="@color/text_secondary" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="Search vehicles..."
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

  </LinearLayout>

  <!-- Vehicle list + empty state wrapped in pull-to-refresh -->
  <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
      android:id="@+id/swipeRefreshHome"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:layout_marginTop="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

      <!-- Empty state -->
      <LinearLayout
          android:id="@+id/emptyStateVehicles"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:orientation="vertical"
          android:gravity="center"
          android:padding="32dp"
          android:visibility="gone">

          <ImageView
              android:layout_width="80dp"
              android:layout_height="80dp"
              android:src="@drawable/ic_empty_vehicle"
              android:alpha="0.3"
              android:tint="@color/accent_lime"
              android:contentDescription="No vehicles" />

          <TextView
              android:id="@+id/tvEmptyTitle"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="No vehicles yet"
              android:textSize="20sp"
              android:textStyle="bold"
              android:textColor="@color/text_primary"
              android:layout_marginTop="16dp" />

          <TextView
              android:id="@+id/tvEmptySubtitle"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Tap the Vehicle button below to add your first vehicle"
              android:textSize="14sp"
              android:textColor="@color/text_secondary"
              android:gravity="center"
              android:layout_marginTop="8dp" />

      </LinearLayout>

      <!-- Vehicle list -->
      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rvVehicles"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@color/bg_primary"
          android:paddingStart="12dp"
          android:paddingEnd="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp"
          android:clipToPadding="false" />

    </FrameLayout>

  </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

  <include
      layout="@layout/footer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"/>

</LinearLayout>
